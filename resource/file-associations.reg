; reveal file associations (Windows registry template)
Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\.png]
@="reveal.png"
"Content Type"="image/png"

[HKEY_CLASSES_ROOT\.jpg]
@="reveal.jpg"
"Content Type"="image/jpeg"

[HKEY_CLASSES_ROOT\.jpeg]
@="reveal.jpeg"
"Content Type"="image/jpeg"

[HKEY_CLASSES_ROOT\.gif]
@="reveal.gif"
"Content Type"="image/gif"

[HKEY_CLASSES_ROOT\.webp]
@="reveal.webp"
"Content Type"="image/webp"

[HKEY_CLASSES_ROOT\.bmp]
@="reveal.bmp"
"Content Type"="image/bmp"

[HKEY_CLASSES_ROOT\.tif]
@="reveal.tif"
"Content Type"="image/tiff"

[HKEY_CLASSES_ROOT\.tiff]
@="reveal.tiff"
"Content Type"="image/tiff"

[HKEY_CLASSES_ROOT\.ico]
@="reveal.ico"
"Content Type"="image/x-icon"

[HKEY_CLASSES_ROOT\.tga]
@="reveal.tga"
"Content Type"="image/x-tga"

[HKEY_CLASSES_ROOT\.pnm]
@="reveal.pnm"
"Content Type"="image/x-portable-anymap"

[HKEY_CLASSES_ROOT\.hdr]
@="reveal.hdr"
"Content Type"="image/vnd.radiance"

[HKEY_CLASSES_ROOT\.avif]
@="reveal.avif"
"Content Type"="image/avif"

[HKEY_CLASSES_ROOT\.svg]
@="reveal.svg"
"Content Type"="image/svg+xml"

[HKEY_CLASSES_ROOT\.jxl]
@="reveal.jxl"
"Content Type"="image/jxl"
